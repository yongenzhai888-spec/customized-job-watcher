# 复制成 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，密码不会进仓库。

# ── 监测目标 ────────────────────────────────────────────────
# 默认就是「中国大陆 + Apple Pay 产品线」。想换筛选条件，
# 直接去 jobs.apple.com 勾选好，把浏览器地址栏的 URL 粘过来即可。
APPLE_JOBS_SEARCH_URL=https://jobs.apple.com/zh-cn/search?location=china-CHNC&product=apple-pay-APPAY

# ── 收件人（必填，多个地址用逗号分隔）──────────────────────────
# 故意不写死在代码里：仓库是公开的，邮箱进了源码会被爬虫抓去发垃圾邮件。
MAIL_TO=你的邮箱@gmail.com

# ── 发件邮箱（Gmail 必须用「应用专用密码」，不是登录密码）────────
# 顺序不能反：先开两步验证 https://myaccount.google.com/signinoptions/twosv
# 再创建应用专用密码 https://myaccount.google.com/apppasswords
# 若第二步提示「您的账号不支持您正在尝试的设置」，说明两步验证还没真正开启。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=你的Gmail地址@gmail.com
SMTP_PASSWORD=你的16位应用专用密码
# 不填则用 SMTP_USERNAME 作为发件人
MAIL_FROM=

# 拿不到 Gmail 应用专用密码时，改用 QQ 邮箱发信即可（收件人不用变，照样收到 Gmail）。
# QQ 邮箱设置 → 账户 → 开启 SMTP 服务 → 获取「授权码」填到 SMTP_PASSWORD：
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SSL=true
# SMTP_STARTTLS=false
# SMTP_USERNAME=你的QQ号@qq.com
# SMTP_PASSWORD=授权码

# 填好后用这条命令验证：
#   PYTHONPATH=src python3 -m applepay_watch mailtest --send

# ── 翻译 ────────────────────────────────────────────────────
# auto（默认）= 有 key 就用 key，没有就用免费的 Google 网页接口
# 可选：llm / deepl / google / mymemory / none
TRANSLATOR=auto

# 配置任意 OpenAI 兼容接口可获得最好的翻译质量（推荐）
# OpenAI:   LLM_BASE_URL=https://api.openai.com/v1           LLM_MODEL=gpt-4o-mini
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1         LLM_MODEL=deepseek-chat
# 通义千问: LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# DeepL 免费版 key 以 :fx 结尾，程序会自动识别并走 api-free 域名
DEEPL_API_KEY=

# ── 其他 ────────────────────────────────────────────────────
# 首次运行是否把现有岗位全部当作"新增"发一遍（默认 false，只建立基线）
NOTIFY_ON_FIRST_RUN=false
STATE_FILE=
OUTPUT_DIR=
